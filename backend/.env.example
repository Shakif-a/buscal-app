# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# Comma-separated frontend origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:3000

# Optional production tuning.
TRUST_PROXY=
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
OKR_RATE_LIMIT_WINDOW_MS=60000
OKR_RATE_LIMIT_MAX=600

# Set true in tests, migrations, and short-lived administration jobs.
SKIP_SCHEDULER=false

# Local Test 1 account. Seeding is blocked unless explicitly enabled and is
# always blocked in production.
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@okrew.test
DEMO_ADMIN_PASSWORD=
